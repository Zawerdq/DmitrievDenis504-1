<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>susanin_esp32_bridge</name>
  <version>0.1.0</version>
  <description>Мост ROS 2 — ESP32 для робота «Сусанин ИИ»: передача команд гусеницам по WebSocket, контроль связи, эмулятор прошивки.</description>
  <maintainer email="todo@example.com">Susanin AI team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <!-- websocket-client: клиент WebSocket для связи с ESP32 -->
  <exec_depend>python3-websocket</exec_depend>
  <!-- websockets: нужен только эмулятору прошивки (тесты и режим fake_esp32) -->
  <exec_depend>python3-websockets</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
